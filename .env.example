# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=your apikey here

# Optional overrides (defaults shown)
# SL_JEV_MODEL=jev-1.13.0
# SL_JEV_TIMEOUT_S=5
# SL_SCAM_THRESHOLD=0.85
# SL_SAFE_THRESHOLD=0.25
# SL_MIN_RISK_CONFIDENCE=0
# (0 turns the risk_level confidence gate off)
# SL_RED_FLAG_THRESHOLD=0.6
